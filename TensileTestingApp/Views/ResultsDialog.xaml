<Window x:Class="TensileTestingApp.Views.ResultsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test Results" Height="520" Width="700" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Tensile Test Results" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <!-- Chart placeholder -->
                <Border Grid.Column="0" Background="#FAFAFA" CornerRadius="6" Margin="0,0,12,0" Padding="8">
                    <ContentControl x:Name="PlotViewHost"/>
                </Border>
                <!-- Results -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <TextBlock Text="Elastic Modulus (E):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="ElasticModulusText" FontSize="16" Margin="0,0,0,8"/>
                    <TextBlock Text="Yield Strength (σ₀.₂):" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <TextBlock x:Name="YieldStrengthText" FontSize="16" Margin="0,0,0,8"/>
                    <TextBlock Text="Ultimate Strength (σₘₐₓ):" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <TextBlock x:Name="UltimateStrengthText" FontSize="16"/>
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Save" Width="100" Margin="0,0,8,0"/>
            <Button x:Name="CloseButton" Content="Close" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
