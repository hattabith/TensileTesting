<Page x:Class="TensileTestingApp.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TensileTestingApp.Views"
      xmlns:ViewModel="clr-namespace:TensileTestingApp.ViewModel" xmlns:oxy="http://oxyplot.org/wpf"
      mc:Ignorable="d" 
      d:DesignHeight="960" d:DesignWidth="1280" d:MinWidth="1024" d:MinHeight="768"
      Title="MainPage">
    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
             <ColumnDefinition />
             <ColumnDefinition />
             <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
            <Label Content="COM port" Margin="10 10 0 10" />
            <ComboBox Name="COMPortComboBox" ItemsSource="{Binding Path=PortList}" Margin="0 10 10 10" Height="22" Width="100" SelectedIndex="2" 
                      ToolTip="Select COM port widt ICP-CON device"/>
            <Label Content="Baud Rate" Margin="0 10 0 10" />
            <ComboBox Name="BaudRateComboBox" ItemsSource="{Binding Path=BaudRatesValues}" Margin="0 10 10 10" Height="22" Width="100" SelectedIndex="3"
                      ToolTip="Select BaudRate, by default it is 9600">
            </ComboBox>
            <Label Content="RS-485 Address" Margin="0 10 0 10" />
            <ComboBox Name="Address485ComboBox" ItemsSource="{Binding Path=RS485Address}" SelectedIndex="2" Margin="0 10 10 10" Height="22" Width="100" 
                      ToolTip="Address DCON device for RS-485"/>
            <Label Content="CheckSum" Margin="0 10 0 10" />
            <CheckBox Name="CheckSumCheckBox" Margin="0 16 0 10" IsChecked="True" ToolTip="CheckSum Enable/Disable"/>
            <Button Name="ConnectButton" Content="Connect" Margin="10 10 0 10" Width="100" Height="22" Click="ConnectButton_Click" 
                    ToolTip="Connect to COM port and start Recive/transmit data"/> 
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="0">
            <StackPanel Orientation="Horizontal"  HorizontalAlignment="Left" VerticalAlignment="Top">
                <Label Content="Specimen name" Margin="10 10 0 10" ></Label>
                <TextBox Text="" Margin="0 10 0 10" Width="100" Height="22" ToolTip="Enter specimen name or experiment name"></TextBox>
                <Label Content="Type" Margin="10 10 0 10" />
                <ComboBox Name="SpecimenTypeComboBox" ItemsSource="{Binding Path=SpecimenTypeValues}" Margin="0 10 10 10" Height="22" Width="100" SelectedIndex="0"
                          ToolTip="Type of spiceman. Under construction. Today only &quot;Cylindrscal&quot; working... ">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="IsEnabled" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Static ViewModel:MainWindowViewModel+SpecimenType.Cylindrical}">
                                    <Setter Property="IsEnabled" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Label Content="Diameter" Margin="10 10 0 10" />
                <TextBox Name="DiameterTextBox" Text="" Margin="0 10 0 10" Width="50" Height="22" ToolTip="Specimen diameter in mm"></TextBox>
                <Label Content="Height" Margin="10 10 0 10" />
                <TextBox Name="GaugeLengthTextBox" Text="" Margin="0 10 0 10" Width="50" Height="22" ToolTip="Specimen height in mm"></TextBox>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Column="2" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Label Content="Input\Output: " FontWeight="Bold" Margin="10 10 0 10" />
            <ScrollViewer Name="OutputScrollViewer"  VerticalScrollBarVisibility="Auto" Margin="10 0 0 10" Width="400" Height="200" VerticalAlignment="Bottom" VerticalContentAlignment="Top">
               <!-- <TextBlock Name="OutputTextBlock"  FontWeight="Bold" Margin="0 0 0 0" Width="380" Background="LightGray" TextWrapping="Wrap" MinWidth="400" MinHeight="200" VerticalAlignment="Bottom"/> -->
                <TextBox Name="OutputTextBox" Margin="0 0 0 0" Width="380" BorderThickness="1" Background="LightGray" TextWrapping="Wrap" MinWidth="400" 
                         MinHeight="200" VerticalAlignment="Bottom" ToolTip="Transmit/Recive data from COM port"/>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Label Content="Force: " FontSize="28" Width="120"/>
                <TextBlock Name="ForceDSeg7" Text="0.0" FontFamily="{DynamicResource Dseg7Font}" FontStyle="Normal" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
                <Label Content="kN" FontSize="28" VerticalAlignment="Center" Margin="5 0 0 0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Label Content="Corrected: " FontSize="20" Width="120" Foreground="#228B22"/>
                <TextBlock Name="CorrectedForceDSeg7" Text="&#x2014;" FontFamily="{DynamicResource Dseg7Font}" FontSize="20"
                           Foreground="#228B22" FontWeight="Bold" VerticalAlignment="Center"/>
                <Label Content="kN" FontSize="20" VerticalAlignment="Center" Margin="5 0 0 0" Foreground="#228B22"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Label Content="Length: " FontSize="28" Width="120" />
                <TextBlock Name="LengthDSeg7" Text="0.0" FontFamily="{StaticResource Dseg7Font}" FontSize="28" VerticalAlignment="Center" />
                <Label Content="mm" FontSize="28" VerticalAlignment="Center" Margin="5 0 0 0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Label Content="Corrected: " FontSize="20" Width="120" Foreground="#228B22"/>
                <TextBlock Name="CorrectedLengthDSeg7" Text="&#x2014;" FontFamily="{StaticResource Dseg7Font}" FontSize="20"
                           Foreground="#228B22" VerticalAlignment="Center"/>
                <Label Content="mm" FontSize="20" VerticalAlignment="Center" Margin="5 0 0 0" Foreground="#228B22"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Label Content="File Name: " Margin="10 10 0 10"/>
                <TextBox Name="FileNameTextBox" Margin="0 10 0 10" Width="100" Height="22" ToolTip="Enter file name for start processing data and save it" IsEnabled="False"/>
                <Button Name="RecordButton" Content="Start" Width="100" Height="22" Margin="10 10 0 10"
                        ToolTip="Start/Stop data acquisition" IsEnabled="False" Click="RecordButton_Click"/>
            </StackPanel>

            <GroupBox Header="Zero &amp; Preload Calibration" Margin="10 5 10 5">
                <StackPanel Orientation="Vertical" Margin="4 4 4 4">
                    <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
                        <Button Name="ZeroButton" Content="Establish Zero" Width="110" Height="22"
                                IsEnabled="False" Click="ZeroButton_Click"
                                ToolTip="Capture current signal as baseline zero"/>
                        <Button Name="ClearZeroButton" Content="Clear" Width="50" Height="22" Margin="5 0 0 0"
                                IsEnabled="False" Click="ClearZeroButton_Click"
                                ToolTip="Reset zero correction"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                        <TextBlock Text="F offset:" Width="55" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock Name="ForceOffsetText" Text="&#x2014;" VerticalAlignment="Center" Width="60" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text="kN" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock Name="ZeroQualityDot" Text="&#x25CF;" FontSize="14" VerticalAlignment="Center"
                                   Margin="8 0 0 0" Foreground="Gray" ToolTip="Baseline quality"/>
                        <TextBlock Name="ZeroTimestampText" Text="" FontSize="10" VerticalAlignment="Center"
                                   Margin="6 0 0 0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 2 0 4">
                        <TextBlock Text="L offset:" Width="55" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock Name="LengthOffsetText" Text="&#x2014;" VerticalAlignment="Center" Width="60" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text="mm" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                    <Separator Margin="0 3 0 3"/>
                    <StackPanel Orientation="Horizontal" Margin="0 2 0 2">
                        <TextBlock Text="Mode:" Width="45" VerticalAlignment="Center" FontSize="11"/>
                        <ComboBox Name="PreloadModeComboBox" Width="165" Height="22"
                                  SelectionChanged="PreloadModeComboBox_SelectionChanged"
                                  ToolTip="Mode A: subtract preload force offset; Mode B: shift length origin at threshold">
                            <ComboBoxItem Content="A &#x2013; Force offset subtraction" IsSelected="True"/>
                            <ComboBoxItem Content="B &#x2013; Length origin shift"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 3 0 2">
                        <TextBlock Text="Threshold:" Width="60" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Name="PreloadThresholdTextBox" Text="0.5" Width="50" Height="22" LostFocus="PreloadThresholdTextBox_LostFocus"
                                 ToolTip="Preload threshold in kN"/>
                        <TextBlock Text="kN" Margin="4 0 10 0" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock Name="PreloadStatusText" Text="Waiting" Foreground="Gray"
                                   VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>



        <oxy:PlotView Model="{Binding ForcePlot}" Grid.Column="0" Grid.Row="2"/>
        <oxy:PlotView Model="{Binding LengthPlot}" Grid.Column="1" Grid.Row="2"/>
        <oxy:PlotView Model="{Binding ForceLengthPlot}" Grid.Column="2" Grid.Row="2"/>
    </Grid>

</Page>
